---
import "../../styles/global.css";
import { siteConfig } from "../../config/site-config";
import MainLayout from "src/layouts/MainLayout.astro";
import AuthorCard from "src/components/AuthorCard.astro";
import { getCollection } from "astro:content";

const authorsData = await getCollection("author");
---

<MainLayout>
  <section class="container px-6 py-10 mx-auto">
    <h1>
      <h1
        class="text-3xl font-semibold text-gray-800 capitalize lg:text-4xl dark:text-white"
      >
        {siteConfig.title}
      </h1>
    </h1>
  </section>

  <section class="grid grid-cols-1 sm:grid-cols-2 gap-2">
    <!-- Author Card -->
    {authorsData.map((author) => <AuthorCard author={author} />)}
  </section>
</MainLayout>
