---
import type { GetStaticPaths } from "astro";
// Type GetStaticPaths de Astro
import BlogPost from "src/components/BlogPost.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import "../../styles/global.css";

export const getStaticPaths = (async ({ paginate }) => {
  const blogPost = await getCollection("blog");

  return paginate(blogPost, { pageSize: 2 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<MainLayout>
  <div class="py-10 mx-auto">
    <h1 class="text-3xl font-semibold capitalize lg:text-4xl text-white">
      Fernando's Blog paginado
    </h1>
  </div>

  <section class="bg-gray-900" aria-label="Entradas de blog">
    <div class="grid grid-cols-1 gap-8 mt-8 md:mt-16 md:grid-cols-2">
      {page.data.map((post) => <BlogPost post={post} />)}
    </div>
  </section>

  <section aria-label="Controles" class="flex justify-between mt-10">
    <a
      href={page.url.prev}
      class:list={{
        "bg-blue-500 hover:bg-blue-600": page.url.prev,
        "bg-gray-600": !page.url.prev,
      }}
      class="text-white p-2 rounded cursor-pointer"
    >
      Anteriores
    </a>
    <a
      href={page.url.next}
      class:list={{
        "bg-blue-500 hover:bg-blue-600": page.url.next,
        "bg-gray-600": !page.url.next,
      }}
      class="text-white p-2 rounded cursor-pointer"
    >
      Siguientes
    </a>
  </section>
</MainLayout>
